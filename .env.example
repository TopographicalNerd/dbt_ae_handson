export DATABASE_NAME=FY26_DB # 共有DB（変更不要）
export WAREHOUSE_NAME=FY26_WH # 共有WH（変更不要）
export USER_NAME="x.yyy@datumstudio.jp" # 自分のSnowflakeユーザー名（メールアドレス）に変更する
export USER_SCHEMA_PREFIX=X_YYY # スキーマ接頭辞（例: 田中 太郎 = TARO_TANAKA）に変更する
export PRIVATE_KEY_PATH=$HOME/.ssh/datum/snowflake/sandbox/<ssh_key_filename> # 自分のSSH秘密鍵のファイル名に変更する
export DBT_PROFILES_DIR=<このリポジトリの絶対パス>/0_init/ds_training/ # 各自のリポジトリ配置パスに変更する
# export PRIVATE_KEY_PASSPHRASE=hogehoge # SSH秘密鍵にパスフレーズが設定されている場合は、コメントアウトを外してパスフレーズを入力する